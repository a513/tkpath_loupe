# @configure_input@
#
if {[package vsatisfies [package provide Tcl] 9.0]} {
    package ifneeded tkpath @PACKAGE_VERSION@ [list apply [list dir {
	load [file join $dir @PKG_LIB_FILE9@]
	# Allow optional redirect of library components.
	# Only necessary for testing, but could be used elsewhere.
	if {[info exists ::env(TKPATH_LIBRARY)]} {
	    set dir $::env(TKPATH_LIBRARY)
	}
	source [file join $dir tkpath.tcl]
    }] $dir]
} else {
    package ifneeded tkpath @PACKAGE_VERSION@ [list apply [list dir {
	load [list [file join $dir @PKG_LIB_FILE8@]]
	# Allow optional redirect of library components.
	# Only necessary for testing, but could be used elsewhere.
	if {[info exists ::env(TKPATH_LIBRARY)]} {
	    set dir $::env(TKPATH_LIBRARY)
	}
	source [file join $dir tkpath.tcl]
    }] $dir]
}
#*EOF*
